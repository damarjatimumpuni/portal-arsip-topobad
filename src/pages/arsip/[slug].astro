---
import "../../styles/global.css";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
    const arsipList = await getCollection("arsip");
    return arsipList.map((arsip) => ({
        params: { slug: arsip.id },
    }));
}

const { slug } = Astro.params;
const arsip = await getEntry("arsip", slug);

if (!arsip) {
    return Astro.redirect("/404");
}

const data = arsip.data;
const jenis = data.kategori_dokumen?.discriminant;
const detail = data.kategori_dokumen?.value || {};

const labelKategori =
    {
        undangan: "Undangan",
        surat_tugas: "Surat Tugas",
        berkas_rapat: "Berkas Rapat",
        berkas_perjadin: "Berkas Perjadin",
        ba_notulen: "Berita Acara / Notulen",
        laporan: "Laporan",
        ranpermendagri: "Ranpermendagri",
    }[jenis] || "Arsip";

// Buat link embed Google Drive
let embedUrl = "";
if (data.tautan_utama) {
    const match = data.tautan_utama.match(/\/d\/(.*?)\/|\?id=(.*?)(&|$)/);
    const fileId = match ? match[1] || match[2] : null;
    if (fileId) {
        embedUrl = `https://drive.google.com/file/d/${fileId}/preview`;
    }
}
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{data.title} - Detail Arsip</title>
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
    </head>
    <body
        class="bg-slate-50 text-slate-800 font-sans antialiased flex flex-col min-h-screen"
    >
        <nav class="bg-sky-900 text-white shadow-md">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16 items-center">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-folder-tree text-2xl text-sky-100"
                        ></i>
                        <div>
                            <h1 class="text-lg font-bold leading-tight">
                                Arsip Terpadu
                            </h1>
                            <p class="text-xs text-sky-100">
                                Sistem Manajemen Dokumen Internal
                            </p>
                        </div>
                    </div>
                    <div>
                        <a
                            href="/"
                            class="text-sky-100 hover:text-white font-medium text-sm flex items-center gap-2"
                        >
                            <i class="fa-solid fa-arrow-left"></i> Kembali ke Beranda
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <main
            class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full grid grid-cols-1 lg:grid-cols-3 gap-8"
        >
            {/* Kolom Kiri: Detil Informasi Dokumen */}
            <div class="lg:col-span-1 space-y-6">
                <div
                    class="bg-white rounded-lg shadow-sm border border-slate-200 p-6"
                >
                    <span
                        class="bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded inline-block mb-3"
                        >{labelKategori}</span
                    >
                    <h2
                        class="text-xl font-extrabold text-slate-900 leading-snug mb-4"
                    >
                        {data.title}
                    </h2>

                    <div
                        class="space-y-3 text-sm border-t border-slate-100 pt-4 text-slate-600"
                    >
                        <p>
                            <i class="fa-regular fa-clock w-5 text-slate-400"
                            ></i> Diupload: <span
                                class="font-medium text-slate-800"
                                >{data.tanggal_upload}</span>
                        </p>

                        {
                            jenis === "undangan" && (
                                <>
                                    <p>
                                        <i class="fa-solid fa-envelope w-5 text-slate-400" />{" "}
                                        No. Surat:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.no_surat}
                                        </span>
                                    </p>
                                    <p>
                                        <i class="fa-solid fa-building w-5 text-slate-400" />{" "}
                                        Asal Instansi:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.asal_instansi}
                                        </span>
                                    </p>
                                    <p>
                                        <i class="fa-regular fa-calendar w-5 text-slate-400" />{" "}
                                        Tanggal Surat:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.tanggal_surat}
                                        </span>
                                    </p>
                                </>
                            )
                        }

                        {
                            jenis === "surat_tugas" && (
                                <>
                                    <p>
                                        <i class="fa-solid fa-briefcase w-5 text-slate-400" />{" "}
                                        No. Surat Tugas:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.no_surat}
                                        </span>
                                    </p>
                                    <p>
                                        <i class="fa-regular fa-calendar w-5 text-slate-400" />{" "}
                                        Tanggal:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.tanggal}
                                        </span>
                                    </p>
                                </>
                            )
                        }

                        {
                            jenis === "berkas_rapat" && (
                                <>
                                    <p>
                                        <i class="fa-solid fa-users w-5 text-slate-400" />{" "}
                                        Jenis Rapat:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.jenis_rapat}
                                        </span>
                                    </p>
                                    <p>
                                        <i class="fa-regular fa-calendar w-5 text-slate-400" />{" "}
                                        Tgl Rapat:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.tanggal_rapat}
                                        </span>
                                    </p>
                                    <p>
                                        <i class="fa-solid fa-file-invoice w-5 text-slate-400" />{" "}
                                        Nota Dinas:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.no_nota_dinas}
                                        </span>
                                    </p>
                                </>
                            )
                        }

                        {
                            jenis === "berkas_perjadin" && (
                                <>
                                    <p>
                                        <i class="fa-solid fa-plane w-5 text-slate-400" />{" "}
                                        Tujuan:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.tujuan}
                                        </span>
                                    </p>
                                    <p>
                                        <i class="fa-solid fa-briefcase w-5 text-slate-400" />{" "}
                                        No. ST:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.no_surat_tugas}
                                        </span>
                                    </p>
                                    <p>
                                        <i class="fa-regular fa-calendar w-5 text-slate-400" />{" "}
                                        Tanggal:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.tanggal_perjadin}
                                        </span>
                                    </p>
                                </>
                            )
                        }

                        {
                            jenis === "laporan" && (
                                <p>
                                    <i class="fa-regular fa-calendar w-5 text-slate-400" />{" "}
                                    Tanggal Laporan:{" "}
                                    <span class="font-medium text-slate-800">
                                        {detail.tanggal}
                                    </span>
                                </p>
                            )
                        }

                        {
                            jenis === "ba_notulen" && (
                                <>
                                    <p>
                                        <i class="fa-solid fa-file-signature w-5 text-slate-400" />{" "}
                                        No BA:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.no_ba}
                                        </span>
                                    </p>
                                    <p>
                                        <i class="fa-regular fa-calendar w-5 text-slate-400" />{" "}
                                        Tanggal:{" "}
                                        <span class="font-medium text-slate-800">
                                            {detail.tanggal}
                                        </span>
                                    </p>
                                </>
                            )
                        }

                        {
                            (detail.uraian || detail.isian_singkat) && (
                                <div class="pt-3 border-t border-slate-100">
                                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">
                                        Uraian / Keterangan
                                    </p>
                                    <p class="italic text-slate-600 bg-slate-50 p-3 rounded">
                                        {detail.uraian || detail.isian_singkat}
                                    </p>
                                </div>
                            )
                        }
                    </div>

                    <div
                        class="mt-6 pt-4 border-t border-slate-100 flex flex-col gap-2"
                    >
                        {
                            data.tautan_utama && (
                                <a
                                    href={data.tautan_utama}
                                    target="_blank"
                                    class="w-full flex items-center justify-center gap-2 bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 px-4 py-2.5 rounded-md text-sm font-semibold transition-colors"
                                >
                                    <i class="fa-solid fa-file-pdf" /> Buka File
                                    Utama
                                </a>
                            )
                        }
                        {
                            data.tautan_lampiran && (
                                <a
                                    href={data.tautan_lampiran}
                                    target="_blank"
                                    class="w-full flex items-center justify-center gap-2 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 px-4 py-2.5 rounded-md text-sm font-semibold transition-colors"
                                >
                                    <i class="fa-solid fa-paperclip" /> Buka
                                    Lampiran
                                </a>
                            )
                        }
                    </div>
                </div>
            </div>

            {/* Kolom Kanan: Live Preview Dokumen (Iframe GDrive) */}
            <div class="lg:col-span-2">
                <div
                    class="bg-white rounded-lg shadow-sm border border-slate-200 p-4 h-full flex flex-col"
                >
                    <h3
                        class="text-sm font-bold text-slate-700 mb-3 flex items-center gap-2"
                    >
                        <i class="fa-solid fa-eye text-sky-600"></i> Pratinjau Berkas
                        Dokumen
                    </h3>

                    <div
                        class="flex-grow bg-slate-100 rounded-lg overflow-hidden min-h-[600px] border border-slate-200 relative flex items-center justify-center"
                    >
                        {
                            embedUrl ? (
                                <iframe
                                    src={embedUrl}
                                    class="w-full h-full absolute inset-0"
                                    allow="autoplay"
                                    title="Preview Dokumen"
                                />
                            ) : (
                                <div class="text-center p-6 text-slate-400">
                                    <i class="fa-solid fa-triangle-exclamation text-3xl mb-2 text-amber-500" />
                                    <p class="text-sm font-medium">
                                        Tautan Utama GDrive belum diisi.
                                    </p>
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-slate-900 text-slate-400 py-6 mt-auto">
            <div class="max-w-7xl mx-auto px-4 text-center text-sm">
                <p>&copy; 2026 Portal Arsip Terpadu Internal.</p>
            </div>
        </footer>
    </body>
</html>

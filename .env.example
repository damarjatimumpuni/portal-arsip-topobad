# ============================================
# AI Router — Local configuration
# Salin file ini menjadi `.env` lalu isi nilainya.
# File `.env` sudah di-ignore oleh git, TIDAK akan ter-push.
# ============================================

# --- Gemini (Google AI Studio) ---
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# --- Maia Router (OpenAI-compatible gateway) ---
# Endpoint & key dari dashboard akun Maia (api.maiarouter.ai)
MAIA_API_KEY=
MAIA_BASE_URL=https://api.maiarouter.ai/v1

# Model yang tersedia lewat Maia (dari settings Zed):
#   zai/glm-4.5-flash
#   deepseek/deepseek-v4-flash
#   openai/gpt-4.1-nano
#   maia/imagen-4.0-fast-generate-001
